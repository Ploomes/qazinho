{
  "name": "@salve-software/qazinho",
  "productName": "QAzinho",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first desktop app where AI agents test your web and mobile apps from a test plan.",
  "license": "UNLICENSED",
  "author": "Salve Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salve-Software/qazinho.git"
  },
  "homepage": "https://github.com/Salve-Software/qazinho#readme",
  "bugs": {
    "url": "https://github.com/Salve-Software/qazinho/issues"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:reset": "node scripts/dev-reset.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:fast": "tsgo --noEmit -p tsconfig.node.json --composite false && tsgo --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky || true",
    "test:smoke": "vitest run --config tests/vitest.smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "i18next": "^26.4.2",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "motion": "^13.3.0",
    "mp4-muxer": "^5.2.2",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semantic-release": "^25.0.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yml,yaml,css,html}": "prettier --write"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.63.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
